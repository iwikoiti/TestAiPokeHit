<?xml version="1.0" encoding="utf-8"?>
<!-- Разметка виджета «Случайный покемон». Только RemoteViews-совместимые вьюхи:
     LinearLayout, ImageView, TextView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_random_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_random_pokemon_label"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_details"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_icon_background"
            android:clickable="true"
            android:contentDescription="@string/widget_open_details"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_info" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_artwork_description"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_pokeball" />

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_hint_shuffle"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>